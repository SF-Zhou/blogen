/target
/dist
/.docker-bin
.DS_Store
*.swp
# dev-only reference renderer deps
/scripts/reference/node_modules/
/scripts/reference/package-lock.json
# local verification scratch space
/scripts/verify/.cache/
# generated trial sites
/tmp-site/

# Cargo.lock *is* committed: release builds use `--locked` so the exact
# dependency set of every published binary is reproducible.
# The parent directory may ignore Cargo.lock globally; this repository tracks it.
!Cargo.lock

# Python bytecode from the release tooling
__pycache__/
*.pyc
